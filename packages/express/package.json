{
  "name": "@rate-fence/express",
  "version": "0.1.1",
  "description": "Express middleware adapter for RateFence",
  "license": "MIT",
  "author": {
    "name": "Ali Sher Khan",
    "email": "alisherkhan032@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0",
    "rate-fence": "^0.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.3",
    "express": "^5.1.0",
    "rate-fence": "workspace:*",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "rate-fence",
    "express",
    "middleware",
    "rate-limit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alisherkhan032/rate-fence.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/Alisherkhan032/rate-fence/issues"
  },
  "homepage": "https://github.com/Alisherkhan032/rate-fence#readme"
}
